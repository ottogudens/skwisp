DEBUG=True
SECRET_KEY=change-me
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos principal (Django)
DATABASE_URL=postgres://skwisp:skwisp@localhost:5432/skwisp

# Base de datos de FreeRADIUS (schema separado, mismo Postgres o instancia distinta)
RADIUS_DATABASE_URL=postgres://radius:radius@localhost:5433/radius
RADIUS_DB_PASSWORD=change-me

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0

# Mercado Pago
MP_ACCESS_TOKEN=your-mp-access-token
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# Facturación
BILLING_GRACE_DAYS=10

# FreeRADIUS — NAS autorizados (ver freeradius/clients.conf.example).
# Con WireGuard, estas IPs son las internas del túnel (10.10.10.x), no las públicas.
RADIUS_RB4011_IP=10.10.10.2
RADIUS_RB4011_SECRET=change-me-generate-with-openssl-rand-hex-32
# RADIUS_CCR1016_IP=
# RADIUS_CCR1016_SECRET=

# Hub WireGuard (ver WIREGUARD_SETUP.md) — solo aplica si despliegas el servicio
# "wireguard" del docker-compose.yml en tu VPS/servidor propio (no en Railway).
WIREGUARD_PUBLIC_HOST=vpn.fibrapuconcore.cl
WIREGUARD_UI_PASSWORD_HASH=generar-con-comando-de-wg-easy
