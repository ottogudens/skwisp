+# clients.conf — declaración de NAS (routers MikroTik) autorizados a hablar con FreeRADIUS.
+#
+# IMPORTANTE — seguridad:
+# Cada bloque "client" acepta peticiones RADIUS (UDP 1812/1813) desde una IP concreta usando
+# un shared secret propio. NUNCA declares un client con ipaddr = 0.0.0.0/0 en producción:
+# eso permite que cualquier IP en internet intente autenticarse contra tu FreeRADIUS con solo
+# adivinar el secret (fuerza bruta por UDP contra tus credenciales PPPoE).
+#
+# Si tu FreeRADIUS corre detrás de un proxy/PaaS (Railway) que no preserva la IP de origen real
+# del router, la alternativa correcta NO es abrir 0.0.0.0/0: es conectar el MikroTik a FreeRADIUS
+# por una VPN/IPsec site-to-site, de forma que la IP que ve FreeRADIUS sea siempre la IP interna
+# fija del túnel. Ver MANUAL_DESPLIEGUE_RAILWAY.md, sección "Seguridad RADIUS".
+#
+# Cada NAS real tiene su propio bloque, su propia IP y su propio secret — así puedes revocar
+# el acceso de un router sin afectar a los demás, y sabes exactamente cuál generó cada evento
+# en los logs de FreeRADIUS.
+
+# --- Laboratorio: RB4011 (pruebas antes de tocar producción) ---
+client rb4011_lab {
+    ipaddr     = $ENV{RADIUS_RB4011_IP}
+    secret     = $ENV{RADIUS_RB4011_SECRET}
+    shortname  = rb4011-lab
     nastype    = mikrotik
 }
+
+# --- Producción: CCR1016 (FibraPuconCore core router) ---
+# Descomentar y completar las variables de entorno cuando se migre producción.
+# client ccr1016_core {
+#     ipaddr     = $ENV{RADIUS_CCR1016_IP}
+#     secret     = $ENV{RADIUS_CCR1016_SECRET}
+#     shortname  = ccr1016-core
+#     nastype    = mikrotik
+# }
+
+# --- Solo para desarrollo local sin IP pública conocida (docker-compose en tu propia máquina) ---
+# Si estás probando 100% en localhost y conoces la IP LAN real del RB4011, NO uses este bloque:
+# usa el de arriba con esa IP. Este bloque queda documentado únicamente como último recurso,
+# nunca para producción ni para un despliegue expuesto a internet.
+# client dev_open {
+#     ipaddr     = 0.0.0.0/0
+#     secret     = $ENV{RADIUS_DEV_SECRET}
+#     shortname  = dev-open
+#     nastype    = other
+#     require_message_authenticator = yes
+# }
